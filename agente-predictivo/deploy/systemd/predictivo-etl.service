[Unit]
Description=ETL AgroDash->Supabase (ingesta del Agente Predictivo)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ec2-user
SupplementaryGroups=docker
ExecStart=/usr/bin/docker exec predictivo-predictivo-1 python -m predictivo.etl
# Una corrida colgada no puede bloquear al timer indefinidamente. El ETL normal
# tarda segundos; 10 min cubre un backfill grande con margen de sobra.
TimeoutStartSec=10min
# Tag propio en el journal: `journalctl -t predictivo-etl` sale limpio.
SyslogIdentifier=predictivo-etl
