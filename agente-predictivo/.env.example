# ── Agente de pronóstico — variables de entorno ──────────────────────────────
# Copiá este archivo a .env y completá los valores. NUNCA subas .env al repo.
#
# El LLM se usa SOLO para orquestar (entender la pregunta y redactar); los números
# salen de la herramienta física. Por eso Haiku alcanza y es barato/rápido.

# Clave de la API de Anthropic (para el agente conversacional de Python; en
# VisioneFlow el LLM lo maneja la plataforma).
ANTHROPIC_API_KEY=

# Modelo LLM. Haiku alcanza para orquestar; subí a Sonnet/Opus solo si hiciera falta.
ANTHROPIC_MODEL=claude-haiku-4-5

# ── Conexión a la base de datos (SOLO LECTURA) ───────────────────────────────
# DB POR URL (recomendado): una sola cadena. Conectar Cartago u otra réplica =
# cambiar esta URL, cero cambios de código. Si se define, MANDA sobre AGRODASH_*.
#   DATABASE_URL=postgresql://usuario:contraseña@host:5432/basedatos
DATABASE_URL=

# Alternativa por partes (compat). Solo se usan si DATABASE_URL está vacío.
AGRODASH_HOST=100.100.130.47
AGRODASH_PORT=5432
AGRODASH_DB=agrodash_control
AGRODASH_USER=postgres
AGRODASH_PASSWORD=

# ── Perfil del sitio (intercambiable por env, sin tocar código) ──────────────
# Defaults = San Carlos (validado). Para otro sitio/réplica, sobreescribí lo que
# cambie (p. ej. Cartago) y listo. NO hace falta para PROBAR: el caché parquet
# ya trae San Carlos.
SITE_NAME=San Carlos
SITE_LAT=10.33
SITE_LON=-84.42
SITE_ALT=600
SITE_TZ=America/Costa_Rica

# Qué leer de la DB (tipo de sensor, caja y canal de irradiancia) y ventana usable.
SENSOR_TYPE=irradiancia
BOX_NAME=Caja Irradiancia SC
IRRADIANCE_CHANNEL=45a5c0a7-0ef4-4291-96f3-60d2b60a0584
WINDOW_START=2026-03-10
WINDOW_END=2026-07-01

# Archivo de caché parquet (por sitio, para no mezclar series). Regenerar con:
#   python -m pronostico.data
CACHE_FILE=irradiancia_sc.parquet
