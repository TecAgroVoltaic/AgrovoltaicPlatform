# URLs de los dos servicios de agentes (los levanta dev.sh en local).
# Solo se leen del lado servidor (route handlers) -> las keys NUNCA llegan al browser.
ANALIZADOR_URL=http://127.0.0.1:8010
PRONOSTICO_URL=http://127.0.0.1:8000

# API keys (opcionales): dejalas vacias en local (los servicios corren sin key).
# En un despliegue con key, copialas aca.
ANALIZADOR_API_KEY=
PRONOSTICO_API_KEY=

# ── Gate de acceso a la consola ──────────────────────────────────────────────
# OBLIGATORIA en cualquier despliegue: sin ella, en produccion la app responde
# 503 (falla cerrada). Vacia en local = sin gate, para no estorbar el desarrollo.
# Generar una fuerte:  openssl rand -base64 24
DEBUGGER_PASSWORD=

# Secreto para firmar la cookie de sesion. Si se omite, se firma con la
# password. Conviene definirlo aparte: rotarlo cierra todas las sesiones sin
# tener que cambiarle la password al equipo.
#   openssl rand -hex 32
DEBUGGER_SESSION_SECRET=
