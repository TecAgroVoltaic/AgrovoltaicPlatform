# Variables del sidecar del historico (copiar a historico.env y completar; NO se versiona).

# DB: Supabase PV de AgroVoltaic (Session pooler, pooler público → reachable desde la EC2
# sin Tailscale). El servicio solo LEE. Formato: postgresql://usuario:clave@host:5432/db
DATABASE_URL=

# Clave que exige POST /tool/* en el header x-api-key (la misma va en cada httpRequestTool
# del canvas). Generar: openssl rand -hex 32
HISTORICO_API_KEY=

# Rango histórico disponible (informativo, para el system prompt del aiAgent).
DATA_DESDE=2024-11-10
DATA_HASTA=2026-06-01

# ── Latencia: cuantas consultas van a la vez y cuanto vale una entrada cacheada ──
# Contra el pooler de Supabase (us-east-1) cada ida y vuelta cuesta ~225 ms pase lo
# que pase, asi que el tiempo de un endpoint es basicamente `viajes x 225 ms`. Los
# tres numeros de abajo son los que gobiernan eso; los defaults ya estan medidos y
# solo hay que tocarlos si cambia la latencia o el techo de conexiones del pooler.

# Conexiones de lectura del pool. Tiene que ser >= HISTORICO_PARALELO_MAX o el pool
# pasa a ser el cuello. Medido: con 6 (el valor viejo) cinco vistas simultaneas
# hacen cola; de 12 en adelante ya no mejora.
HISTORICO_POOL_MAX=12

# Cuantas consultas en vuelo a la vez en todo el proceso por la via paralela. Es el
# freno que impide que un endpoint ancho monopolice el pool.
HISTORICO_PARALELO_MAX=8

# Segundos que vale una entrada del cache del bloque `confianza`. Es el TOPE de
# cuanto podria durar un veredicto viejo si el barrido corre en otro proceso (por
# cron), asi que subirlo alarga exactamente ese agujero. `0` apaga el cache: la
# coalescencia de peticiones simultaneas se pierde y la vista vuelve a pagar la
# misma consulta una vez por endpoint.
HISTORICO_CACHE_TTL_SEG=10
