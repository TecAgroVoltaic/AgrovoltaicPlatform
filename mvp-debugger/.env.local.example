# URLs de los dos servicios de agentes (los levanta dev.sh en local).
# Solo se leen del lado servidor (route handlers) -> las keys NUNCA llegan al browser.
HISTORICO_URL=http://127.0.0.1:8010
PREDICTIVO_URL=http://127.0.0.1:8000

# API keys (opcionales): dejalas vacias en local (los servicios corren sin key).
# En un despliegue con key, copialas aca.
HISTORICO_API_KEY=
PREDICTIVO_API_KEY=

# ── Gate de acceso a la consola ──────────────────────────────────────────────
# OBLIGATORIA en cualquier despliegue: sin ella, en produccion la app responde
# 503 (falla cerrada). Vacia en local = sin gate, para no estorbar el desarrollo.
# Generar una fuerte:  openssl rand -base64 24
DEBUGGER_PASSWORD=

# Secreto para firmar la cookie de sesion. Si se omite, se firma con la
# password. Conviene definirlo aparte: rotarlo cierra todas las sesiones sin
# tener que cambiarle la password al equipo.
#   openssl rand -hex 32
DEBUGGER_SESSION_SECRET=

# ── Que agentes muestra la consola ───────────────────────────────────────────
# El chat del Agente Historico esta HABILITADO por defecto (ver app/lib/agentes.ts).
# Para bloquearlo:  AGENTE_HISTORICO=off  (corta /api/historico/{chat,preguntar}
# y /api/asistente/chat con 503, no solo los botones).
AGENTE_HISTORICO=

# ── Motor del chat del asistente ─────────────────────────────────────────────
# plataforma (default) = backend propio (/chat/stream del Historico)
# flow                 = agente de Visione Flow (canal web), traducido a los mismos eventos
# La cookie `av_motor=flow|plataforma` lo pisa para una sesion (pruebas).
ASISTENTE_MOTOR=
# URL completa del webhook de streaming del agente en Flow:
#   https://<runtime>/api/webhooks/<agentId>/web/stream
FLOW_WEBHOOK_URL=
# Clave x-api-key del webhook. OBLIGATORIA con motor flow: el webhook es publico.
# Solo servidor: nunca con prefijo NEXT_PUBLIC_.
FLOW_WEBHOOK_KEY=
