# ── Historico PV — variables de entorno ─────────────────────────────────────
# Copiá a .env y completá. NUNCA subas .env al repo.
# El LLM SOLO orquesta (entiende/rutea/redacta); los números salen de las tools.

# Clave de la API de Anthropic.
ANTHROPIC_API_KEY=

# Modelo LLM. Haiku alcanza para orquestar; subí a Sonnet solo si hiciera falta.
ANTHROPIC_MODEL=claude-haiku-4-5

# ── Base de datos (Supabase PV de AgroVoltaic, SOLO LECTURA) ─────────────────
# Si no la definís acá, el historico usa el DATABASE_URL del .env de la raíz del
# repo (el mismo del pipeline). Sesión pooler, usuario postgres.<ref>.
#   HISTORICO_DB_URL=postgresql://postgres.<ref>:<pass>@aws-1-...pooler.supabase.com:5432/postgres
HISTORICO_DB_URL=

# Rango histórico disponible (para el system prompt). Ajustar al re-cargar datos.
DATA_DESDE=2024-11-10
DATA_HASTA=2026-06-01

# ── Latencia (opcionales; los defaults ya estan medidos) ────────────────────
# Cada viaje al pooler cuesta ~225 ms, asi que lo que manda es cuantos viajes hace
# un endpoint, no el SQL. Detalle en la cabecera de `src/historico/db.py`.
#   HISTORICO_POOL_MAX=12         conexiones de lectura (>= PARALELO_MAX)
#   HISTORICO_PARALELO_MAX=8      consultas en vuelo a la vez en todo el proceso
#   HISTORICO_CACHE_TTL_SEG=10    vida de una entrada de `confianza`; 0 lo apaga
