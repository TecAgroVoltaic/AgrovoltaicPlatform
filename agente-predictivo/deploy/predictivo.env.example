# Variables del sidecar del Predictivo (copiar a predictivo.env y completar; NO se versiona).
#
# Es el subconjunto de `.env.example` que el SERVICIO necesita en el server. Lo
# que no aparece aca (AGRODASH_* por partes, CACHE_FILE) solo hace falta en local.

# Fuente de datos ambientales. El ESQUEMA de la URL elige el camino (ver `ingesta/`):
#
#   https://       API publica de AgroDash: la app de Cartago, sin credenciales ni
#                  tailnet. Es BASE VIVA (~30 s de rezago). La de hoy.
#   postgresql://  DB directa (Cartago por tailnet) o una replica del dump.
#
# Por que se cambio (2026-08-26): la replica del dump quedo congelada el 2026-06-30
# y tuvo al store 33 dias sin avanzar mientras el ETL corria "verde" trayendo cero
# filas cada 15 min. El problema nunca fue que Cartago estuviera caido (su app
# estaba sirviendo): lo inalcanzable era el puerto Postgres por tailnet.
#
# Alternativas, por si hay que volver:
#   DATABASE_URL=postgresql://postgres:CLAVE@127.0.0.1:5433/agrodash_control     # replica del dump
#   DATABASE_URL=postgresql://agrovoltaic_ro:CLAVE@100.101.177.71:5432/control   # Cartago por tailnet
DATABASE_URL=https://agrodash.nm.35-208-114-233.nip.io/api/v1

# LLM (solo orquesta: los numeros salen de las tools).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Clave unica que exige la API en el header x-api-key. Generar: openssl rand -hex 32
FORECAST_API_KEY=

# Claves CON NOMBRE (opcional, reemplaza a la anterior): `nombre:clave` separadas
# por comas. Sirve para saber quien consume y revocar de a una sin tocar al resto.
#   FORECAST_API_KEYS=consola:sk_aaa,visioneflow:sk_bbb
FORECAST_API_KEYS=

# Store de salida del ETL (Supabase PV, Session pooler).
STORE_URL=

# Perfil del sitio: San Carlos.
SITE_NAME=San Carlos
SITE_LAT=10.33
SITE_LON=-84.42
SITE_ALT=600
SITE_TZ=America/Costa_Rica

# Que leer de la DB y ventana usable.
SENSOR_TYPE=irradiancia
BOX_NAME=Caja Irradiancia SC
IRRADIANCE_CHANNEL=45a5c0a7-0ef4-4291-96f3-60d2b60a0584
WINDOW_START=2026-06-01
WINDOW_END=2027-01-01
